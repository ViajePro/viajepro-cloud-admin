{
  "name": "viajepro-cloud-admin",
  "version": "1.0.0",
  "description": "Módulo administrativo para ViajeProCloud",
  "main": "index.js",
  "scripts": {
    "clean": "rm -rf dist",
    "build": "node build.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "sam:build": "npm run build && sam build",
    "deploy:dev": "npm run sam:build && sam deploy --config-env dev",
    "deploy": "sam deploy",
    "start:local": "sam local start-api",
    "dev": "npm run build && npm run start:local"
  },
  "dependencies": {
    "aws-sdk": "^2.1450.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.2"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.119",
    "@types/jest": "^29.5.4",
    "@types/node": "^20.5.9",
    "@types/uuid": "^9.0.3",
    "esbuild": "^0.19.5",
    "jest": "^29.6.4",
    "ts-jest": "^29.1.1",
    "typescript": "^5.2.2"
  }
}