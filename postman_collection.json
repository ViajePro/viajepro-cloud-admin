  "item": [
    {
      "name": "Finanzas",
      "item": [
        {
          "name": "Obtener Reporte de Ingresos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/finance/income-report?startDate=2023-01-01&endDate=2023-12-31",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "finance",
                "income-report"
              ],
              "query": [
                {
                  "key": "startDate",
                  "value": "2023-01-01"
                },
                {
                  "key": "endDate",
                  "value": "2023-12-31"
                }
              ]
            },
            "description": "Obtiene un reporte de ingresos para un período específico"
          },
          "response": []
        },
        {
          "name": "Obtener Deudas de Choferes",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/finance/driver-debts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "finance",
                "driver-debts"
              ]
            },
            "description": "Obtiene la lista de todos los choferes con sus deudas acumuladas"
          },
          "response": []
        },
        {
          "name": "Obtener Deuda de Chofer Específico",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/finance/driver-debts/{{driverId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "finance",
                "driver-debts",
                "{{driverId}}"
              ]
            },
            "description": "Obtiene la deuda acumulada de un chofer específico"
          },
          "response": []
        },
        {
          "name": "Registrar Pago de Chofer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"driverId\": \"{{driverId}}\",\n  \"amount\": 1000.50,\n  \"description\": \"Pago de comisiones semana 32\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/finance/driver-payments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "finance",
                "driver-payments"
              ]
            },
            "description": "Registra un pago realizado por un chofer para saldar parcial o totalmente su deuda"
          },
          "response": []
        },
        {
          "name": "Registrar Deuda por Viaje",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"travelId\": \"{{travelId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"amount\": 500.00,\n  \"companyCommission\": 100.00,\n  \"paymentMethod\": \"CASH\",\n  \"description\": \"Deuda por viaje {{travelId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/travel-debt",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "travel-debt"
              ]
            },
            "description": "Registra una deuda generada por un viaje completado"
          },
          "response": []
        }
      ],
      "description": "Endpoints relacionados con la gestión financiera"
    },
    {
      "name": "Configuración",
