            },
            "description": "Obtiene la configuración actual para el cálculo de costos de viaje y comisiones"
          },
          "response": []
        },
        {
          "name": "Actualizar Configuración de Costos de Viaje",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"baseFare\": 100,\n  \"perKilometerRate\": 10,\n  \"driverCommissionPercentage\": 80\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/config/travel-cost",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "config",
                "travel-cost"
              ]
            },
            "description": "Actualiza la configuración para el cálculo de costos de viaje y comisiones"
          },
          "response": []
        }
      ],
      "description": "Endpoints relacionados con la configuración del sistema"
